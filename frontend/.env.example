# --- Live landing stats (/api/stats) ---
# Private/dedicated Celo RPC for the live on-chain stats route. Set this to a
# provider URL (Ankr, dRPC, QuickNode, …) to scan in parallel without forno's
# rate limits. Leave unset to fall back to public forno (conservative pacing).
# STATS_RPC_URL=https://your-private-celo-rpc
# Optional tuning (sensible defaults are chosen from STATS_RPC_URL):
# STATS_MAX_CHUNKS=4000
# STATS_CONCURRENCY=8
# STATS_PACE_MS=0
