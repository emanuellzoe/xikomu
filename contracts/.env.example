# Deployer private key (NO 0x prefix needed for some tools; Foundry accepts 0x...)
PRIVATE_KEY=0xyour_deployer_private_key

# Savings token. Leave unset for Celo MAINNET cUSD (0x765DE816845861e75A25fCA122bb6898B8B1282a).
# For Alfajores testnet cUSD use: 0x874069Fa1Eb16D44d622F2e0Ca25eeA172369bC1
# CUSD_ADDRESS=

# Initial owner (can ONLY pause/unpause). Defaults to deployer. Use a multisig in prod.
# OWNER=

# RPCs
CELO_RPC=https://forno.celo.org
ALFAJORES_RPC=https://alfajores-forno.celo-testnet.org

# Celoscan API key for contract verification
CELOSCAN_API_KEY=
