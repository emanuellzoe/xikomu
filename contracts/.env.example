# Deployer/owner private key. Needs real CELO for gas (+ for HOUSE_AMOUNT seeding).
PRIVATE_KEY=0xyour_deployer_private_key

# Initial owner (house top-up + pause only). Defaults to deployer. Use a multisig in prod.
# OWNER=

# Whole CELO to seed the house pool at deploy (sent as msg.value). 0 = skip.
HOUSE_AMOUNT=0

# RPCs
CELO_RPC=https://forno.celo.org

# Celoscan API key for contract verification (Etherscan API V2).
# Verify with: --verifier-url https://api.etherscan.io/v2/api?chainid=42220
CELOSCAN_API_KEY=
