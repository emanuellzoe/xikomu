# Which network: celo | alfajores | local
CHAIN=alfajores

# Optional RPC override (else uses the chain default)
# RPC_URL=

# Keeper signer (pays gas; holds NO user funds). 32-byte hex.
KEEPER_PRIVATE_KEY=0xyour_keeper_private_key

# Deployed AutoSaveVault address
VAULT_ADDRESS=0x...

# Block the vault was deployed at (keeper scans events from here)
START_BLOCK=0

# Loop cadence + per-cycle cap
INTERVAL_SECONDS=60
BATCH_SIZE=25
